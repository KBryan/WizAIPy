# flake8 does not read pyproject.toml; everything else lives there.
[flake8]
max-line-length = 120
extend-exclude = .venv,alembic,htmlcov,logs
# E203/W503 conflict with black's formatting
extend-ignore = E203,W503
per-file-ignores =
    # __init__ re-exports
    */__init__.py:F401
statistics = true
count = true
